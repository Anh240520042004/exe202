# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/fptaiez

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# AI Chatbot GPT
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Payment Gateway Configuration
# VNPay
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# SePay (Auto-confirm banking transfer)
SEPAY_API_KEY=your_sepay_api_key
SEPAY_WEBHOOK_URL=https://exe202-x7o6.onrender.com/api/payments/sepay-webhook
SEPAY_BANK_BIN=970438
SEPAY_BANK_CODE=BIDV
SEPAY_BANK_DISPLAY_NAME=BIDV
SEPAY_ACCOUNT_NUMBER=96247ANH2004
SEPAY_ACCOUNT_NAME=LE DUC ANH

# MoMo
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/pay/create
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

# Email Configuration (Mock - logs to console)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@fptaiez.com
