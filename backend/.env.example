# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/fptaiez

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# OpenAI API (for AI Study Assistant)
OPENAI_API_KEY=your_openai_api_key_here

# Payment Gateway Configuration
# VNPay
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_RETURN_URL=http://localhost:5173/payment/return

# MoMo
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/pay/create
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

# Email Configuration (Mock - logs to console)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@fptaiez.com
SMTP_PASS=your_email_password

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
