# For Gmail: Use App Password from Google Account Settings
# For Outlook: Use App Password from Microsoft Account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
